APP_NAME=iAppoint
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ──────────────────────────────────────────────────────────────────
# Use sqlite for local dev (no config needed), or mysql for production
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=iappoint
# DB_USERNAME=root
# DB_PASSWORD=

# ─── Session / Queue / Cache ───────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ─── Mail ──────────────────────────────────────────────────────────────────────
# For local dev: MAIL_MAILER=log (no real emails sent)
# For production: use smtp with Mailtrap, Mailgun, SendGrid, etc.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@iappoint.app"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Redis (optional — only if you switch cache/queue to redis) ────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── AWS S3 (optional — only if you use cloud file storage) ───────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Vite ──────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ─── Google OAuth ──────────────────────────────────────────────────────────────
# Required for "Sign in with Google" feature
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → Credentials → OAuth 2.0 Client ID
# 3. Add your callback URL: https://YOUR_DOMAIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
